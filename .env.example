# ------------------------------------------------------------------------------
# Smart Attendance — configuração de exemplo
# Copie para .env (cp .env.example .env) e rode: php artisan key:generate
# Guia completo: docs/instalacao.md · Produção: docs/deploy.md
# ------------------------------------------------------------------------------

APP_NAME=SmartAttendance
APP_ENV=local
# Criptografa os dados pessoais e é a chave dos blind indexes.
# Não troque depois de ter dados: os registros deixam de ser encontrados.
APP_KEY=
APP_DEBUG=true
# Para o QR Code funcionar no celular, use o IP da máquina (ex.: http://192.168.1.100:8000)
# ou o endereço de um túnel (cloudflared). Veja docs/instalacao.md.
APP_URL=http://localhost
# Domínios extras aceitos no cabeçalho Host (separados por vírgula), ex.: chamada.escola.edu.br
# Sem listar o domínio aqui, em produção o site responde 400. Veja docs/deploy.md.
TRUSTED_HOSTS=
# Define a data das chamadas: mantenha no fuso da instituição.
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Banco de dados (PostgreSQL) ----------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smart_attendance
DB_USERNAME=postgres
DB_PASSWORD=
# Produção no Supabase: DB_SEARCH_PATH=laravel e DB_SSLMODE=require
DB_SEARCH_PATH=public
DB_SSLMODE=prefer

# --- Sessão, cache e fila ------------------------------------------------------
# Sessões e códigos das chamadas ficam no banco.
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção (HTTPS): SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail ------------------------------------------------------------------
# "log" grava os e-mails em storage/logs/laravel.log. Sem envio real, o Master
# vê na tela o token de primeiro acesso de quem cadastrar.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@exemplo.com"
MAIL_FROM_NAME="Smart Attendance"

# Servidor de e-mail da INSTITUIÇÃO. Escolha um bloco, descomente e preencha.
# Depois, no painel do Master, use "Enviar e-mail de teste" para conferir.
# A porta 587 negocia TLS (MAIL_SCHEME=smtp); para a 465 use MAIL_SCHEME=smtps.
#
# Microsoft 365 / Outlook institucional (a conta precisa ter "SMTP AUTH"
# habilitado pelo administrador do Microsoft 365):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=nao-responda@suainstituicao.edu.br
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="nao-responda@suainstituicao.edu.br"
#
# Google Workspace / Gmail (verificação em duas etapas + senha de app em
# myaccount.google.com/apppasswords):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=nao-responda@suainstituicao.edu.br
# MAIL_PASSWORD=senha_de_app_sem_espacos
# MAIL_FROM_ADDRESS="nao-responda@suainstituicao.edu.br"
#
# Servidor próprio da instituição (Postfix, Exchange local etc.): use o host,
# a porta e o usuário que o setor de TI informar. Para relay interno sem
# autenticação, deixe MAIL_USERNAME e MAIL_PASSWORD vazios.
# MAIL_EHLO_DOMAIN=suainstituicao.edu.br

# --- Produção ----------------------------------------------------------------
# Protege a rota chamada 1x por dia pela Vercel (vercel.json → crons).
# CRON_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Atestados das justificativas de falta ---------------------------------
# local: grava em storage/app/private/justificativas (desenvolvimento).
# s3: Supabase Storage (produção na Vercel, onde o disco é somente leitura).
#     Crie um bucket PRIVADO "justificativas" e gere as chaves em
#     Supabase > Project Settings > Storage > S3 Connection.
JUSTIFICATIVAS_DISK=local
# SUPABASE_S3_ENDPOINT=https://<projeto>.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=sa-east-1
# SUPABASE_S3_BUCKET=justificativas
# SUPABASE_S3_KEY=
# SUPABASE_S3_SECRET=
