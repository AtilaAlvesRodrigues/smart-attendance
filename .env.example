# ------------------------------------------------------------------------------
# Smart Attendance — configuração de exemplo
# Copie para .env (cp .env.example .env) e rode: php artisan key:generate
# Guia completo: docs/instalacao.md · Produção: docs/deploy.md
# ------------------------------------------------------------------------------

APP_NAME=SmartAttendance
APP_ENV=local
# Criptografa os dados pessoais e é a chave dos blind indexes.
# Não troque depois de ter dados: os registros deixam de ser encontrados.
APP_KEY=
APP_DEBUG=true
# Para o QR Code funcionar no celular, use o IP da máquina (ex.: http://192.168.1.100:8000)
# ou o endereço de um túnel (cloudflared). Veja docs/instalacao.md.
APP_URL=http://localhost
# Define a data das chamadas: mantenha no fuso da instituição.
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Banco de dados (PostgreSQL) ----------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smart_attendance
DB_USERNAME=postgres
DB_PASSWORD=
# Produção no Supabase: DB_SEARCH_PATH=laravel e DB_SSLMODE=require
DB_SEARCH_PATH=public
DB_SSLMODE=prefer

# --- Sessão, cache e fila ------------------------------------------------------
# Sessões e códigos das chamadas ficam no banco.
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção (HTTPS): SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail ------------------------------------------------------------------
# "log" grava os e-mails em storage/logs/laravel.log. Sem envio real, o Master
# vê na tela o token de primeiro acesso de quem cadastrar.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@exemplo.com"
MAIL_FROM_NAME="Smart Attendance"

# Envio real pelo Gmail (precisa de verificação em duas etapas e de uma
# senha de app em myaccount.google.com/apppasswords):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp          # a porta 587 negocia TLS; use smtps com a porta 465
# MAIL_USERNAME=seu@gmail.com
# MAIL_PASSWORD=senha_de_app_sem_espacos
# MAIL_FROM_ADDRESS="seu@gmail.com"

# --- Produção ----------------------------------------------------------------
# Protege a rota chamada 1x por dia pela Vercel (vercel.json → crons).
# CRON_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
